{
  "expo": {
    "name": "Period Tracker",
    "slug": "period-tracker",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "periodtracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#fdf2f8",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf2f8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arise.periodtracker"
    },
    "android": {
      "package": "com.arise.periodtracker",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "buildArchs": ["arm64-v8a"],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "color": "#e88fb0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d402228-21f2-487b-9be1-7e4acb71e084"
      }
    }
  }
}
